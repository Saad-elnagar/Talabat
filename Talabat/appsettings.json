    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:3000"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=Talabat_Test;Trusted_Connection=True;MultipleActiveResultSets=True;TrustServerCertificate=True;Encrypt=False;",
    "Identity": "Server=.;Database=Talabat_Identity_Test;Trusted_Connection=True;MultipleActiveResultSets=True;TrustServerCertificate=True;Encrypt=False;",
    "Redis": "localhost"
  },
  "ApiBaseURL": "http://localhost:5208",
  "JwtSettings": {
    "SecretKey": "REPLACE_VIA_USER_SECRETS_OR_ENV_VAR",
